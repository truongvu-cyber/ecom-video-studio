{
  "schema_version": "1.0",
  "project_id": "example-name-hoodie",
  "product_ref": "product.json",
  "platform": "tiktok_reels",
  "stage": "prompts_ready",
  "gen_model": {
    "image": "nano-banana-pro",
    "video": "veo-3"
  },
  "spec": {
    "ratio": "9:16",
    "resolution": "1080x1920",
    "fps": 30,
    "target_sec": 15,
    "safe_zone": {
      "top": 0.15,
      "bottom": 0.2
    }
  },
  "audio": {
    "source": "native",
    "music_duck_db": -12,
    "target_lufs": -14,
    "true_peak_db": -1,
    "export_no_music": true
  },
  "music": {
    "source": "auto",
    "mood": "warm upbeat",
    "bpm_range": [
      100,
      125
    ]
  },
  "captions": {
    "enabled": true,
    "style": "word-highlight"
  },
  "shots": [
    {
      "id": "s01",
      "role": "hook",
      "file_pattern": "c01*.mp4",
      "gen_sec": 8,
      "use_sec": 3.6,
      "audio_type": "dialogue",
      "dialogue": "Wait, you can put his name on it?",
      "overlay": "Gift idea he'll actually wear",
      "overlay_pos": "lower"
    },
    {
      "id": "s02",
      "role": "personalize",
      "file_pattern": "c02*.mp4",
      "gen_sec": 8,
      "use_sec": 2,
      "audio_type": "sfx",
      "overlay": "Type any name"
    },
    {
      "id": "s03",
      "role": "proof",
      "file_pattern": "c03*.mp4",
      "gen_sec": 8,
      "use_sec": 2.5,
      "audio_type": "sfx",
      "print_fidelity": "strict"
    },
    {
      "id": "s04",
      "role": "demo",
      "file_pattern": "c01*.mp4",
      "gen_sec": 8,
      "use_sec": 2.0,
      "audio_type": "dialogue",
      "dialogue": "Any name you want."
    },
    {
      "id": "s05",
      "role": "lifestyle",
      "file_pattern": "c04*.mp4",
      "gen_sec": 8,
      "use_sec": 3,
      "audio_type": "music_only",
      "print_fidelity": "strict"
    },
    {
      "id": "s06",
      "role": "cta",
      "file_pattern": "c01*.mp4",
      "gen_sec": 8,
      "use_sec": 2.5,
      "audio_type": "dialogue",
      "dialogue": "The link is right below.",
      "overlay": "Personalize yours ↓"
    }
  ]
}
